NODE_ENV=development

JWT_SECRET=nexusforge-dev-jwt-secret-2026
GATEWAY_PORT=4000
FRONTEND_PORT=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexusforge
POSTGRES_USER=nexusforge
POSTGRES_PASSWORD=nexusforgepass

MONGO_URI=mongodb://mongo:27017/nexusforge
MONGO_DB=nexusforge

REDIS_URL=redis://redis:6379

NATS_URL=nats://nats:4222
NATS_STREAM=NEXUSFORGE_EVENTS

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexusforge-task-queue

OPA_URL=http://opa:8181
FEATURE_FLAG_URL=http://feature-flags:4010

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRICS_EXPORT_INTERVAL=10000

AUTH_SERVICE_URL=http://auth-service:4001
PROJECT_SERVICE_URL=http://project-service:4002
JOB_SERVICE_URL=http://job-service:4003
FILE_SERVICE_URL=http://file-service:4004
MCP_SERVICE_URL=http://mcp-server:4005
INCIDENT_SERVICE_URL=http://incident-service:4006
WORKER_PYTHON_URL=http://worker-python:5000

SERVICE_SPIFFE_TRUST_DOMAIN=nexusforge.local
MTLS_MODE=disabled
